{
  "name": "dsh-cost-pill",
  "version": "0.1.6",
  "type": "module",
  "description": "DSH Web plugin: a session API-cost + account-balance pill merged into the official composer stats row, with a click-open breakdown panel. Host half registers a `costPill` session projection and a loopback-only balance route; browser half renders it through the slot runtime.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cost",
    "usage",
    "balance",
    "token",
    "费用",
    "余额"
  ],
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daviszhou212/dsh-cost-pill.git"
  },
  "homepage": "https://github.com/Daviszhou212/dsh-cost-pill#readme",
  "bugs": {
    "url": "https://github.com/Daviszhou212/dsh-cost-pill/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./price-source": "./lib/price-source.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/pricing.test.mjs test/balance.test.mjs test/price-source.test.mjs test/host.test.mjs test/client.smoke.test.mjs",
    "check": "node --check lib/pricing.js && node --check lib/balance.js && node --check lib/price-source.js && node --check lib/index.js && node --check lib/client.js && npm test",
    "fold": "node scripts/fold-session.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.7-alpha.2": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
